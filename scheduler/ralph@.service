# Sample systemd template service: one Ralph Loop *tick* in Slot %i.
#
# The template form of ralph.service (ADR-0008, #143): the instance number is
# the Slot number, so `ralph@2.service` ticks in Slot 2, in its own worktree
# (<superproject>.ralph-slot-2) under its own lock. A burst is enabling one more
# instance's timer and ending it is disabling it; the target repository's
# committed `concurrency.max_slots` caps how far that goes -- a tick whose Slot
# is over it refuses before labelling anything. ralph.service and the cron line
# keep running as Slot 1.
#
# INSTALL (per-user, alongside ralph@.timer):
#   mkdir -p ~/.config/systemd/user
#   cp ai-utils/scheduler/ralph@.service ~/.config/systemd/user/
#   cp ai-utils/scheduler/ralph@.timer   ~/.config/systemd/user/
#   # edit the two paths below to your superproject, then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now ralph@1.timer   # Slot 1
#   systemctl --user enable --now ralph@2.timer   # a burst: Slot 2
#   loginctl enable-linger "$USER"
#
# Use either ralph.timer or ralph@1.timer for Slot 1, not both: they are the
# same Slot, and the second would only find the lock held.
#
# PREREQUISITES: `gh auth login` and `claude` must be authenticated for THIS user.

[Unit]
Description=Ralph Loop tick in Slot %i (one autonomous pass through the backlog)
Documentation=https://github.com/Ztubben/ai-utils

[Service]
Type=oneshot
# The instance is the Slot this tick runs in.
Environment=RALPH_SLOT=%i
# EDIT THESE to your superproject (the repo that mounts ai-utils as a submodule):
WorkingDirectory=/path/to/your/superproject
ExecStart=/path/to/your/superproject/ai-utils/bin/ralph.sh
# Keep unattended runs quiet; the tick already logs low-verbosity.
Nice=10
