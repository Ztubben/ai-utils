#!/usr/bin/env bash
# ralph - the Ralph Loop CLI (shipped from ai-utils, invoked from a superproject).
#
# Subcommands are added as stories land. Today:
#   ralph --init [CONFIG]         Bootstrap the superproject: create the canonical labels + base branch.
#   ralph --check-config [PATH]   Validate .ralph.yml (default ./.ralph.yml) and exit.
#   ralph --lint-story PATH       Validate a canonical Ralph story issue (JSON, or - for stdin).
#   ralph --dry-run [PATH]        Scan the backlog and print the next action, changing nothing.
#   ralph --run                   Run one unattended tick (bin/ralph.sh): select, work, promote.
#   ralph --ready-features [PATH] List PRDs eligible for the Feature completion pass (ADR-0006).
#   ralph --branch-name STORY [CONFIG] [PRD]  Print the working branch per story kind (ADR-0006).
#   ralph --run-gating [CONFIG]   Run the configured gating steps locally, fail-fast.
#   ralph --resolve-models [CONFIG] [--implementation KEY] [--review KEY] [--allow-same-model]
#                                 Resolve the implementation/review model profiles.
#   ralph --assign-models STORY [CONFIG] [--implementation KEY] [--review KEY] [--allow-same-model] [--fixed-roles]
#                                 Record the story's implementation/review model identities as labels.
#   ralph --reassign-model STORY ROLE PROFILE [CONFIG] --reason TEXT [--allow-same-model]
#                                 Replace one role's recorded model assignment (human-only, audited).
#   ralph --launch-agent ROLE [CONFIG] [--story PATH] [--implementation KEY] [--review KEY] [--allow-same-model]
#                                 Launch one role's agent in a fresh process (prompt on stdin).
#   ralph --classify-session RC   Did the launched agent hit its session limit? (output on stdin)
#   ralph --implementation-green STORY [CONFIG] [PRD]  Open/update the marked review PR.
#   ralph --review-context STORY PR ROUND [ROOT]  Print exact-head review evidence.
#   ralph --validate-review PAYLOAD [DIFF]  Validate a structured review result.
#   ralph --render-review REVIEW PR [DIFF]  Post a validated review + its required check.
#   ralph --review-round STORY [CONFIG] [ROOT] [--pr PATH]  Run one Negotiation Round on the marked PR.
#   ralph --await-review STORY [CONFIG] [ROOT]  Wait out one bounded review window, polling durable state.
#   ralph --respond-review STORY [CONFIG] [ROOT] [--pr PATH]  Answer a round's findings with append-only fixes.
#   ralph --escalate-review STORY [CONFIG] [ROOT] [--pr PATH] Block a deadlocked Story and ask a human to arbitrate.
#   ralph --arbitrate-review STORY [CONFIG] [ROOT] [--pr PATH] Act on a human Approve / Request changes.
#   ralph --blocked-stories [BACKLOG]  List open state:blocked story numbers.
#   ralph --complete-story STORY [CONFIG] [ROOT] [--pr PATH] [--prd PATH]  Complete a review-approved Story.
#   ralph --checkpoint STORY SUMMARY [CONFIG]  Write a Handoff (WIP commits + issue comment) and stop.
#   ralph --resume STORY [CONFIG]  Resume a checkpointed in-progress story (check out its branch).
#   ralph --record-attempt STORY REASON [CONFIG]  Record a failed Attempt; block the story at the limit.
#   ralph --complete-feature PRD [CONFIG]  Integrate a complete Feature into base (ADR-0006).
#   ralph --record-boundary STORY [CONFIG] [PRD] SHA  Record the feature-branch boundary SHA at story start.
#   ralph --reset-on-block STORY REASON [CONFIG] [PRD]  Quarantine a blocked Feature story on a rescue branch.
#   ralph --check-breaker [BACKLOG] [CONFIG]  Trip the circuit breaker (needs-human + tag) if enough stories are blocked.
#   ralph --needs-freshness ISSUE# [BACKLOG]  Print yes/no: does this Feature story need a base merge?
#   ralph --read-learnings DIR [ROOT]  Print the nested AGENTS.md learnings to read at story start.
#   ralph --learn-target PATH [ROOT]   Print the nearest AGENTS.md to promote a learning to.
set -euo pipefail

RALPH_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat <<'EOF'
usage: ralph --init [CONFIG]
       ralph --check-config [PATH]
       ralph --lint-story PATH
       ralph --dry-run [PATH]
       ralph --run
       ralph --ready-features [PATH]
       ralph --branch-name STORY [CONFIG] [PRD]
       ralph --run-gating [CONFIG]
       ralph --resolve-models [CONFIG] [--implementation KEY] [--review KEY] [--allow-same-model]
       ralph --assign-models STORY [CONFIG] [--implementation KEY] [--review KEY] [--allow-same-model] [--fixed-roles]
       ralph --reassign-model STORY ROLE PROFILE [CONFIG] --reason TEXT [--allow-same-model]
       ralph --launch-agent ROLE [CONFIG] [--story PATH] [--implementation KEY] [--review KEY] [--allow-same-model]
       ralph --classify-session RC
       ralph --implementation-green STORY [CONFIG] [PRD]
       ralph --review-context STORY PR ROUND [ROOT]
       ralph --validate-review PAYLOAD [DIFF]
       ralph --render-review REVIEW PR [DIFF]
       ralph --review-round STORY [CONFIG] [ROOT] [--pr PATH]
       ralph --await-review STORY [CONFIG] [ROOT]
       ralph --respond-review STORY [CONFIG] [ROOT] [--pr PATH]
       ralph --escalate-review STORY [CONFIG] [ROOT] [--pr PATH]
       ralph --arbitrate-review STORY [CONFIG] [ROOT] [--pr PATH]
       ralph --blocked-stories [BACKLOG]
       ralph --complete-story STORY [CONFIG] [ROOT] [--pr PATH] [--prd PATH]
       ralph --complete-afk STORY [CONFIG] [PRD]
       ralph --complete-hil STORY [CONFIG] [PRD]
       ralph --complete-feature PRD [CONFIG]
       ralph --checkpoint STORY SUMMARY [CONFIG] [--comment-only]
       ralph --resume STORY [CONFIG]
       ralph --record-attempt STORY REASON [CONFIG]
       ralph --record-boundary STORY [CONFIG] [PRD] SHA
       ralph --reset-on-block STORY REASON [CONFIG] [PRD]
       ralph --check-breaker [BACKLOG] [CONFIG]
       ralph --needs-freshness ISSUE# [BACKLOG]
       ralph --read-learnings DIR [ROOT]
       ralph --learn-target PATH [ROOT]

  --init [CONFIG]         Bootstrap the superproject for the Ralph Loop:
                          idempotently create the canonical state:/type:/prio:/
                          needs-human/ready-for-human GitHub labels and, if the
                          configured base branch is missing, create it off the
                          repo's default branch. Reads the base from CONFIG
                          (default .ralph.yml). Safe to re-run. Exits 0 on
                          success, 1 on a git/gh failure, 2 on bad config.
  --check-config [PATH]   Validate a .ralph.yml config against the shipped
                          JSON-schema (default: ./.ralph.yml), including the
                          declared control_plane.protected path patterns, which
                          must be repository-relative. Exits 0 on a valid
                          config, non-zero (reporting the offending fields)
                          otherwise.
  --lint-story PATH       Validate a story issue (gh --json shape; PATH may be
                          - for stdin) against the canonical Ralph backlog
                          format. Exits 0 when canonical, non-zero (reporting
                          the offending fields) otherwise.
  --dry-run [PATH]        Scan the backlog and print the next action
                          (resume #N / start #N / no-work / halt) without
                          changing anything. Reads a JSON backlog from PATH
                          (or - for stdin); with no PATH, scans the live
                          backlog via gh.
  --run                   Run one unattended tick (the scheduler's entry point,
                          bin/ralph.sh): flock-guarded, validates .ralph.yml,
                          then drives --dry-run and works each selected story in
                          sequence, promoting green ones, until no eligible work
                          remains. Extra arguments are passed through.
  --ready-features [PATH] Scan the backlog and print, one per line, the PRD
                          numbers eligible for the Feature completion pass
                          (ADR-0006): open, prd + state:ready, at least one
                          story naming it Parent:, all such stories closed.
                          Reads a JSON backlog from PATH (or - for stdin);
                          with no PATH, scans the live backlog via gh.
  --branch-name STORY     Print the working branch for a story (gh --json; -
       [CONFIG] [PRD]     for stdin), per story kind (ADR-0006). An Orphan
                          Story (Parent: None) resolves via branch_pattern
                          (default ralph/{issue}-{slug}); a Feature story
                          (Parent: #N) resolves via feature_pattern (default
                          feature/{issue}-{slug}) from its PRD issue, given
                          as PRD (gh --json path). CONFIG is optional (pass
                          "" to skip). Exits 2 when a Feature story is given
                          without its PRD context.
  --run-gating [CONFIG]   Run the configured gating steps (default .ralph.yml)
                          locally in order, fail-fast, low-verbosity. Exits 0
                          when all pass, 1 on a gating failure, 2 on bad config.
  --resolve-models        Resolve the two model roles from the target
       [CONFIG]           repository's committed model-profile catalog
       [--implementation  (default .ralph.yml). Prints the exact model identity
        KEY]              of the Implementation Agent and the Review Agent, one
       [--review KEY]     per line. A --implementation/--review override selects
       [--allow-same-     that role by profile key and wins over the committed
        model]            default. Refuses (exit 2) when both roles resolve to
                          the same model identity unless --allow-same-model
                          acknowledges it. Exits 0 on success, 2 on bad config
                          or a refusal.
  --assign-models STORY   Record a story's model assignment durably (gh --json
       [CONFIG]           shape; - for stdin). Resolves each role that the story
       [--implementation  does not already carry a label for, creates that
        KEY]              identity's label on demand (model:impl:<id> /
       [--review KEY]     model:review:<id>) and applies it, so retries, resumes
       [--allow-same-     and audits read the assignment from the backlog rather
        model]            than from current configuration. A story that is
       [--fixed-roles]    already assigned is left untouched: changed defaults
                          and --implementation/--review overrides never rewrite
                          it. Idempotent. A story with no assignment at all is a
                          fresh pair, so it takes its turn in the alternation
                          (the resolved order, then swapped, then back) unless
                          --fixed-roles or models.alternate: false holds the
                          roles fixed. Exits 0 on success, 1 on a gh failure,
                          2 on bad config or a refused resolution.
  --reassign-model STORY  Replace one role's recorded model assignment on a
       ROLE PROFILE       story (gh --json shape; - for stdin). Human-only: the
       [CONFIG]           loop never substitutes a model on its own -- an
       --reason TEXT      outage is retried and resumed with the negotiation
       [--allow-same-     round intact. Moves model:impl:<id> / model:review:<id>
        model]            to the new identity and records an audit comment
                          carrying the previous identity, the new one and the
                          reason. Refuses a role with no assignment to replace,
                          a profile outside the allowlist, a no-op replacement,
                          a missing reason, and a swap collapsing both roles
                          onto one identity unless --allow-same-model
                          acknowledges it. Exits 0 on success, 1 on a gh
                          failure, 2 on bad config or a refusal.
  --launch-agent ROLE     Launch one role's agent (implementation | review) in a
       [CONFIG]           fresh process through its provider adapter, resolved
       [--story PATH]     from the target repository's model-profile catalog
       [--implementation  (default .ralph.yml). With --story (a gh --json path),
        KEY]              the story's own model assignment labels decide which
                          model the role runs, so a resume or retry never
                          swaps models. The prompt is read from stdin and
       [--review KEY]     the agent's output is written to stdout. The exit code
       [--allow-same-     is the outcome: 0 normal completion, 10 session
        model]            exhaustion, 12 infrastructure failure, 2 on a bad
                          config or a refused role resolution.
  --classify-session RC   Decide whether a launched agent hit its session
                          limit, given its exit code RC and its output on
                          stdin. Detection is layered (an exit-code set, a
                          family of wording patterns, and an additive
                          RALPH_SESSION_LIMIT_MARKER override), anchored to the
                          tail of the output so an agent *writing about* limits
                          is not mistaken for a limit notice. Exits 10 on
                          session exhaustion, 0 otherwise, 2 on bad input.
  --implementation-green  Promote locally green implementation work into model
       STORY [CONFIG]     review. Pushes the canonical Story/Feature branch,
       [PRD]              creates a pull request carrying Ralph's durable
                          machine marker (or updates the existing marked PR),
                          and moves either an AFK or HIL Story from
                          state:in-progress to state:in-review. Never merges,
                          closes, or moves a HIL Story to awaiting-bench; never
                          targets main. PRD is required for a Feature Story.
                          Exits 0 on success, 1 on git/gh failure, and 2 on bad
                          config or refusal (including an unmarked existing PR).
  --review-context        Print the diff-first evidence bundle for one fresh
       STORY PR ROUND     Review Agent round. STORY and PR are gh-shaped JSON
       [ROOT]             files; PR must carry exact baseRefOid/headRefOid,
                          statusCheckRollup, comments/reviews, and Ralph's
                          managed marker. Includes scoped AGENTS.md guidance,
                          CONTEXT.md/ADRs, CI and durable PR discussion, but no
                          implementation session or Handoff. ROOT defaults to
                          the checkout. The head is resolved exactly before the
                          base/head diff is read. Exits 2 on incomplete evidence.
  --validate-review       Validate a Review Agent's structured result (JSON;
       PAYLOAD [DIFF]     PAYLOAD may be - for stdin) against the shipped
                          versioned contract (schema/review.schema.json, see
                          docs/review-contract.md) before anything is rendered
                          as a GitHub review. Rejects a missing verdict, head,
                          model identity or round; a missing or duplicate
                          finding id; a finding whose blocking classification
                          and category disagree, or that no verdict supports;
                          and an oversized payload. Given DIFF, the reviewed
                          base/head diff, it also rejects a source location the
                          diff never touched. Exits 0 when the result may be
                          posted, 1 (naming the offending fields) when it may
                          not, 2 on unreadable input.
  --render-review         Render a validated review result onto its pull
       REVIEW PR [DIFF]   request: located findings as inline threads on the
                          reviewed commit, cross-cutting ones in the review
                          body, under a header naming the reviewing model, the
                          round and that commit. The review is posted as a
                          COMMENT (GitHub refuses APPROVE/REQUEST_CHANGES on a
                          self-authored PR); the verdict is carried by the one
                          stable required check ralph/model-review. REVIEW and
                          PR are JSON files (- for stdin); the result is
                          re-validated first, so unvalidated output is never
                          posted. A result whose head is no longer the PR's
                          head posts nothing and updates no check. Exits 0 on
                          success, 1 on a gh failure, 2 on a refusal.
  --review-round STORY    Run one Negotiation Round for a Story In Review.
       [CONFIG] [ROOT]    Finds the Story's open, Ralph-managed pull request
       [--pr PATH]        (marker + "Refs #N"; pass --pr to supply it as JSON
                          instead), skips a head that already carries its
                          review, and otherwise launches the Story's assigned
                          Review Agent once, in a fresh read-only process with
                          no GitHub credential, on the diff-first evidence
                          bundle for the exact head. The result is validated
                          against the shipped contract before anything is
                          posted, so invalid reviewer output never reaches the
                          pull request. Runs concurrently with CI and never
                          waits for a check. ROOT defaults to the checkout.
                          Exits 0 when a review was published or the head was
                          already reviewed, 1 when gh refused the review, 2 on
                          a refusal or invalid output, 10 when the reviewing
                          model hit its session limit, 12 when it failed to run.
  --await-review STORY    Wait out one bounded review window for a Story In
       [CONFIG] [ROOT]    Review, inside the tick and inside its lock. Polls
                          durable GitHub state with backing-off intervals
                          (review.wait_minutes, default 60; review.poll_seconds,
                          default 30), runs a Negotiation Round whenever the
                          pull-request head has none, and otherwise just waits —
                          spending no model context and making no invocation.
                          Ends early when there is nothing to negotiate (no open
                          Ralph-managed pull request), and when the round budget
                          (review.max_rounds, default 2) is spent with the two
                          models still owing each other a move -- that Story is
                          escalated to a human. Exits 0 when the negotiation
                          needs no further waiting, 14 when the window closed
                          (the caller owes a Handoff), 15 when the Story was
                          escalated and blocked (the caller may go straight on
                          to other Stories), 16 when the Story passed both
                          halves of the gate and was completed, 1 when a step
                          failed, 2 on bad config or input.
  --escalate-review STORY End automated negotiation for one deadlocked Story.
       [CONFIG] [ROOT]    Summarizes every unsettled blocking finding on the
       [--pr PATH]        pull request with both sides' arguments, requests a
                          native GitHub review from notify.github, and moves the
                          Story from state:in-review to state:blocked. Exactly
                          one Story: unrelated Stories stay selectable, and the
                          global halt remains the circuit breaker's decision --
                          which this newly blocked Story now counts toward.
                          Never applies needs-human. Exits 0 on success, 1 on a
                          gh failure, 2 on bad config or a refusal (an unmarked
                          pull request, or nothing actually unsettled).
  --respond-review STORY  Answer one Negotiation Round that requested changes.
       [CONFIG] [ROOT]    Reads the round's recorded result off the Story,
       [--pr PATH]        launches the Story's assigned implementation model
                          with the open findings, then verifies what came back:
                          the answer must cover every finding exactly once, and
                          the new head must be a descendant of the reviewed
                          commit (an amend, rebase or force-push is refused and
                          nothing is posted). On success it pushes the appended
                          fixes -- creating the new head a fresh review round
                          judges -- replies in each finding's thread, and posts
                          one consolidated machine-readable response. Exits 0 on
                          success, 2 on a refusal or invalid output, 10 when the
                          model hit its session limit, 12 when it failed to run.
                          A finding may be disputed with evidence instead of
                          obeyed: a dispute changes no code (a moved head with
                          nothing accepted is refused) and sends the same commit
                          back to a fresh reviewer, which withdraws or upholds
                          the finding by its identifier. Later rounds adjudicate
                          only the open findings; a blocker raised late must be
                          a defect or a safety regression, and never resets the
                          round count.
  --arbitrate-review      Act on the human's native GitHub review of a Story's
       STORY [CONFIG]     marked pull request. An Approve is authoritative: it
       [ROOT]             releases the ralph/model-review check on the reviewed
       [--pr PATH]        head even while model findings are unresolved, clears
                          any escalation (state:blocked -> state:in-review), and
                          records the override on the Story naming the reviewer
                          and the findings it overrode. A Request changes is
                          authoritative feedback: the Story returns to
                          state:in-review and the assigned implementation model
                          is launched with the human's own words, append-only
                          like any fix round. An ordinary comment changes no
                          label, check or state. Each native review is acted on
                          exactly once, recorded on the Story by its review id.
                          Exits 0 on success (including "nothing to arbitrate"),
                          1 on a git/gh failure, 2 on a refusal, 10/12 on a
                          model session limit or infrastructure failure.
  --blocked-stories       Print, one per line, the open story numbers currently
       [BACKLOG]          at state:blocked -- the Stories a human may have
                          arbitrated since the last tick. Reads a JSON backlog
                          from BACKLOG (or - for stdin); with no BACKLOG, scans
                          live via gh. Exits 0, or 2 on bad input.
  --complete-story STORY   Complete a Story whose current head has passed both
       [CONFIG] [ROOT]     halves of the gate: CI green, and the one
       [--pr PATH]         ralph/model-review context satisfied by an approving
       [--prd PATH]        model review or by a human's Approve. An AFK Orphan
                           Story is merged into base per branching.afk_merge
                           (default squash, so base gets one clean commit while
                           the pull request keeps the whole negotiation as its
                           audit history) and closed as Passing; an AFK Feature
                           Story closes as Passing without merging, because a
                           Feature's code integrates when the Feature merges
                           (ADR-0006). A HIL Story of either kind is never
                           merged: it records a bench anchor at the exact head
                           and moves to state:awaiting-bench, still open. Never
                           targets main. Exits 0 on success, 1 on a gh failure,
                           2 on a refusal (a shut gate reaches GitHub not at
                           all).
  --complete-afk STORY    Complete a green AFK story (gh --json shape; - for
       [CONFIG] [PRD]     stdin) per story kind (ADR-0006). An Orphan Story is
                          auto-merged into base per afk_merge and closed; a
                          Feature story (Parent: #N) is pushed to its feature
                          branch (resolved from its PRD issue, given as PRD)
                          and closed -- no PR, no merge. Never touches main.
                          Exits 0 on success, 1 on a git/gh failure, 2 on bad
                          config or a refusal (incl. a Feature story without
                          its PRD context).
  --complete-hil STORY    Park a green HIL story (gh --json shape; - for
       [CONFIG] [PRD]     stdin) at state:awaiting-bench per story kind
                          (ADR-0006). An Orphan Story is pushed to its story
                          branch and PR'd to base; a Feature story (Parent:
                          #N) is pushed to its feature branch (resolved from
                          its PRD issue, given as PRD) with the completion
                          commit SHA recorded as a bench anchor comment -- no
                          PR. Never merges or closes; never touches main.
                          Exits 0 on success, 1 on a git/gh failure, 2 on bad
                          config or a refusal (incl. a Feature story without
                          its PRD context).
  --complete-feature PRD  Integrate a complete Feature (gh --json PRD issue;
       [CONFIG]           path or - for stdin) into base (ADR-0006).
                          Autosquash-collapses fixup! commits (cosmetic
                          fallback on conflict), rebases onto base, runs full
                          gating, opens a single PR and merges with a merge
                          commit (never squash), then closes the PRD. A rebase
                          conflict or red gate pushes the branch, comments
                          details on the PRD, and labels it ready-for-human
                          (no needs-human). Never touches main. Exits 0 on
                          success, 1 on a blocker, 2 on bad config or refusal.
  --checkpoint STORY      Write a Handoff for an in-progress story: commit + push
       SUMMARY [CONFIG]   WIP to the story branch and post an issue comment
       [--comment-only]   (carrying the handoff marker) with SUMMARY, then stop.
                          Ralph never compacts context. Never touches base/main.
                          --comment-only posts the Handoff comment alone, which
                          is what a Story In Review needs: its work is already
                          pushed, and a commit would move the head a reviewer's
                          findings are bound to. Exits 0 on success, 1 on a
                          git/gh failure, 2 on bad config or a refusal.
  --resume STORY          Resume a checkpointed state:in-progress story: check out
       [CONFIG]           its branch and surface the latest Handoff. Base branch
                          untouched. Exits 0 on success, 1 on a git/gh failure,
                          2 on bad config or a refusal.
  --record-attempt STORY  Record a failed Attempt on a story (gh --json shape; -
       REASON [CONFIG]    for stdin) with a terse REASON. After limits.max_attempts
                          failed Attempts the story moves to state:blocked. A
                          context-full checkpoint is not an Attempt. Exits 0 on
                          success, 1 on a gh failure, 2 on bad config.
  --record-boundary STORY Record the feature-branch boundary SHA at story start
       [CONFIG] [PRD] SHA (gh --json shape; - for stdin). For a Feature story
                          (Parent: #N), posts a boundary comment on the issue
                          recording SHA so reset-on-block can rewind to it. For
                          an Orphan Story, does nothing (exits 0). PRD is the
                          gh --json path for the Feature's PRD issue. Exits 0
                          on success, 1 on a gh failure, 2 on bad config or
                          refusal.
  --reset-on-block STORY  Quarantine a blocked Feature story on a rescue branch
       REASON [CONFIG]    (gh --json shape; - for stdin). Pushes the story's
       [PRD]              work to a rescue branch (rescue_pattern), rewinds the
                          feature branch to the recorded boundary SHA, and posts
                          a demotion comment naming the rescue branch. Orphan
                          Stories are unchanged (exits 0, no commands). Exits 0
                          on success, 1 on a git/gh failure, 2 on bad config
                          or refusal.
  --check-breaker         Trip the circuit breaker if limits.circuit_breaker stories
       [BACKLOG] [CONFIG] are state:blocked: apply needs-human and tag the configured
                          handle, halting the loop. Reads a JSON backlog from BACKLOG
                          (or - for stdin); with no BACKLOG, scans live via gh. Exits
                          0 on success, 1 on a gh failure, 2 on bad config.
  --needs-freshness       Print "yes" or "no": whether a Feature story with
       ISSUE# [BACKLOG]  out-of-Feature dependencies needs a base merge into
                          its feature branch before the iteration starts
                          (ADR-0006). Reads a JSON backlog from BACKLOG (or -
                          for stdin); with no BACKLOG, scans live via gh. An
                          Orphan Story or a story with no out-of-Feature deps
                          always prints "no". Exits 0, or 2 on bad input.
  --read-learnings DIR    Print the nested AGENTS.md learnings (nearest-first,
       [ROOT]             from DIR up to ROOT, default DIR) Ralph reads at the
                          start of a story. Exits 0, or 2 if DIR is missing.
  --learn-target PATH     Print the nearest AGENTS.md a reusable learning for
       [ROOT]             PATH should be promoted to (module-local; a new one in
                          PATH's own directory when none exists up to ROOT,
                          default cwd). Never a progress.txt. Exits 0, or 2 with
                          no PATH.
EOF
}

main() {
  case "${1:-}" in
    --init)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_init.py" init "$@"
      ;;
    --check-config)
      local config="${2:-.ralph.yml}"
      exec python3 "$RALPH_HOME/lib/ralph_config.py" "$config"
      ;;
    --lint-story)
      if [[ -z "${2:-}" ]]; then
        echo "ralph: --lint-story requires a PATH (or - for stdin)" >&2
        exit 2
      fi
      exec python3 "$RALPH_HOME/lib/ralph_story.py" "$2"
      ;;
    --dry-run)
      if [[ -n "${2:-}" ]]; then
        exec python3 "$RALPH_HOME/lib/ralph_select.py" "$2"
      else
        exec python3 "$RALPH_HOME/lib/ralph_select.py"
      fi
      ;;
    --run)
      shift
      exec "$RALPH_HOME/bin/ralph.sh" "$@"
      ;;
    --ready-features)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_select.py" ready-features "$@"
      ;;
    --needs-freshness)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_select.py" needs-freshness "$@"
      ;;
    --branch-name)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_iterate.py" branch-name "$@"
      ;;
    --run-gating)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_iterate.py" run-gating "$@"
      ;;
    --resolve-models)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_models.py" resolve "$@"
      ;;
    --assign-models)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_models.py" assign "$@"
      ;;
    --reassign-model)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_models.py" reassign "$@"
      ;;
    --launch-agent)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_agent.py" launch "$@"
      ;;
    --classify-session)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_session.py" classify "$@"
      ;;
    --implementation-green)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_implementation.py" green "$@"
      ;;
    --review-context)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_review_context.py" bundle "$@"
      ;;
    --validate-review)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_review_result.py" validate "$@"
      ;;
    --render-review)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_review_render.py" render "$@"
      ;;
    --review-round)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_review_round.py" round "$@"
      ;;
    --await-review)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_review_wait.py" await "$@"
      ;;
    --escalate-review)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_review_deadlock.py" escalate "$@"
      ;;
    --arbitrate-review)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_review_human.py" arbitrate "$@"
      ;;
    --complete-story)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_review_complete.py" complete "$@"
      ;;
    --blocked-stories)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_select.py" blocked-stories "$@"
      ;;
    --respond-review)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_review_respond.py" respond "$@"
      ;;
    --complete-afk)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_afk.py" complete "$@"
      ;;
    --complete-hil)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_hil.py" complete "$@"
      ;;
    --complete-feature)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_feature.py" complete "$@"
      ;;
    --checkpoint)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_handoff.py" checkpoint "$@"
      ;;
    --resume)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_handoff.py" resume "$@"
      ;;
    --record-attempt)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_failure.py" record-attempt "$@"
      ;;
    --record-boundary)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_failure.py" record-boundary "$@"
      ;;
    --reset-on-block)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_failure.py" reset-on-block "$@"
      ;;
    --check-breaker)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_failure.py" check-breaker "$@"
      ;;
    --read-learnings)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_memory.py" read-learnings "$@"
      ;;
    --learn-target)
      shift
      exec python3 "$RALPH_HOME/lib/ralph_memory.py" learn-target "$@"
      ;;
    -h|--help|"")
      usage
      ;;
    *)
      echo "ralph: unknown command: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
