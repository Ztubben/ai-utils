#!/usr/bin/env python3
"""A scripted provider CLI for the scenario harness (#87, PRD #85).

Installed on PATH as both `claude` and `codex`.  It works out which provider it
is from its own name and which role it plays from the flags the Loop launched it
with (the review role is the read-only one), then behaves as the scenario's
profile for that role says (`$SCENARIO_AGENTS`, `{role: profile}`).

It records what it was told -- argv and the full prompt -- in the call log
(`$SCENARIO_LOG`), and answers in the provider's own transcript shape, usage
included, so the adapters' unwrapping and the ledger normaliser run for real.
"""
import json
import os
import re
import subprocess
import sys
import tempfile

RALPH = os.environ.get("SCENARIO_RALPH", "ralph")
DONE_MARKER = os.environ.get("RALPH_STORY_COMPLETE_MARKER", "RALPH-STORY-COMPLETE")


PHASES = {"# Ralph Iteration Prompt": "iteration",
          "# Ralph Review Prompt": "review",
          "# Ralph Response Prompt": "response",
          "# Ralph Human Arbitration Prompt": "arbitration"}


def phase_of(prompt):
    """Which stage launched this run, read off the title of the prompt it got."""
    first = prompt.lstrip().split("\n", 1)[0]
    return next((phase for title, phase in PHASES.items()
                 if first.startswith(title)), "unknown")


def told(prompt):
    """The Story, head and round this run was told about, where it was told."""
    story = (re.search(r"^Story: #(\d+)", prompt, re.M)
             or re.search(r"^Next action: \w+ #(\d+)", prompt, re.M))
    head = re.search(r"^Exact head commit: ([0-9a-f]{40})", prompt, re.M)
    round_no = re.search(r"^Review round: (\d+)", prompt, re.M)
    return {"story": int(story.group(1)) if story else None,
            "head": head.group(1) if head else None,
            "round": int(round_no.group(1)) if round_no else None}


def role_of(provider, argv):
    if provider == "claude":
        return "review" if "plan" in argv else "implementation"
    return "review" if "read-only" in argv else "implementation"


def model_of(argv):
    return argv[argv.index("--model") + 1] if "--model" in argv else None


def run(args, **kw):
    return subprocess.run(args, check=True, stdout=subprocess.PIPE, text=True, **kw).stdout


# --- profiles ----------------------------------------------------------------

def implement_cooperatively(context):
    """Do the Story's work on its own branch, commit, push, signal done."""
    issue = str(context["story"])
    story = json.loads(run(["gh", "issue", "view", issue, "--json",
                            "number,title,labels,body,state"]))
    with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as fh:
        json.dump(story, fh)
    config = os.environ.get("RALPH_CONFIG", ".ralph.yml")
    branch = run([RALPH, "--branch-name", fh.name, config]).strip()
    base = run([RALPH, "--branch-name", fh.name, config, "--base"]).strip()
    os.unlink(fh.name)
    run(["git", "fetch", "-q", "origin"])
    have = subprocess.run(["git", "rev-parse", "-q", "--verify",
                           "refs/remotes/origin/%s" % branch],
                          stdout=subprocess.DEVNULL).returncode == 0
    run(["git", "checkout", "-q", "-B", branch,
         "origin/%s" % (branch if have else base)])
    path = "story-%s.txt" % issue
    with open(path, "a") as fh:
        fh.write("work for #%s\n" % issue)
    run(["git", "add", path])
    run(["git", "commit", "-q", "-m", "feat: #%s" % issue])
    run(["git", "push", "-q", "origin", "refs/heads/%s:refs/heads/%s" % (branch, branch)])
    return "Implemented #%s on %s; the gate is green.\n%s" % (issue, branch, DONE_MARKER)


def review_approving(context):
    """An approving review of exactly the head and round it was handed."""
    result = {"contract": "ralph-review/v1", "verdict": "approve",
              "head": context["head"], "model": context["model"] or "unknown",
              "round": context["round"],
              "summary": "Every acceptance criterion is met at this head.",
              "findings": []}
    return "Review complete.\n```json\n%s\n```" % json.dumps(result, indent=1)


FINDING = {
    "id": "F-1", "blocking": True, "category": "acceptance_criteria",
    "claim": "The greeting is written but never checked by a test.",
    "evidence": "The change adds the story file and no test that reads it.",
    "requirement": "Acceptance criterion: the greeting exists (and is verified).",
    "verification": "Add a test that reads the greeting back.",
}


def diff_anchor(prompt):
    """The first line the reviewed diff touches -- the only place an inline
    finding may anchor (a location outside the diff is refused)."""
    diff = re.search(r"## Base/Head Diff\s*```diff\n(.*?)```", prompt, re.S)
    path = hunk = None
    for line in (diff.group(1) if diff else "").splitlines():
        if line.startswith("+++ b/"):
            path = line[6:]
        hunk = hunk or (path and re.match(r"^@@ -\S+ \+(\d+)", line))
        if path and hunk:
            return {"path": path, "line": int(hunk.group(1))}
    return None


def requesting_changes(context):
    """A request_changes review holding the one blocking finding, F-1."""
    finding = dict(FINDING)
    anchor = diff_anchor(context["prompt"])
    if anchor:
        finding["location"] = anchor
    result = {"contract": "ralph-review/v1", "verdict": "request_changes",
              "head": context["head"], "model": context["model"] or "unknown",
              "round": context["round"],
              "summary": "One acceptance criterion is not yet verified.",
              "findings": [finding]}
    return "Review complete.\n```json\n%s\n```" % json.dumps(result, indent=1)


def review_strict_once(context):
    """Request changes in round one; approve whatever is presented after it."""
    if context["round"] == 1:
        return requesting_changes(context)
    return review_approving(context)


def open_findings(prompt):
    match = re.search(r"## Open findings \(round (\d+), commit ([0-9a-f]+)\)\s*"
                      r"```json\s*(.*?)```", prompt, re.S)
    return int(match.group(1)), match.group(2), json.loads(match.group(3))["findings"]


def response(context, disposition_for):
    round_no, head, findings = open_findings(context["prompt"])
    answer = {"contract": "ralph-response/v1", "head": head, "round": round_no,
              "model": context["model"] or "unknown",
              "summary": "Answered every open finding of round %d." % round_no,
              "dispositions": [disposition_for(f) for f in findings]}
    return "Round answered.\n```json\n%s\n```" % json.dumps(answer, indent=1)


def respond_by_fixing(context):
    """Append a fix commit to the pull request's own branch; accept everything.

    Ralph pushes it; the agent only commits, on the branch the round names.
    """
    # The bundle names the reviewed commit, not the branch: the local Story
    # branch is the one that contains it.
    branch = run(["git", "for-each-ref", "--format=%(refname:short)", "--contains",
                  open_findings(context["prompt"])[1], "refs/heads/ralph/"]).split()[0]
    run(["git", "checkout", "-q", branch])
    path = "test-story-%s.txt" % context["story"]
    with open(path, "a") as fh:
        fh.write("the greeting is verified\n")
    run(["git", "add", path])
    run(["git", "commit", "-q", "-m", "test: verify the greeting"])
    return response(context, lambda f: {"id": f["id"], "disposition": "accepted",
                                        "note": "Added the test the finding asks for."})


def respond_by_disputing(context):
    """Change nothing; dispute every finding, with evidence."""
    return response(context, lambda f: {
        "id": f["id"], "disposition": "disputed",
        "note": "The acceptance criterion does not ask for a test.",
        "evidence": "The Story's Acceptance Criteria list only 'the greeting exists'."})


# A profile is a behaviour per phase; the scenario picks a profile per role.
PROFILES = {
    "cooperative": {"iteration": implement_cooperatively,
                    "review": review_approving,
                    "response": respond_by_fixing},
    "dispute-all": {"iteration": implement_cooperatively,
                    "response": respond_by_disputing},
    "strict-once": {"review": review_strict_once},
    "strict": {"review": requesting_changes},
}


# --- transcript shapes -------------------------------------------------------

USAGE = {"claude": {"input_tokens": 1200, "cache_creation_input_tokens": 0,
                    "cache_read_input_tokens": 300, "output_tokens": 400},
         "codex": {"input_tokens": 1500, "cached_input_tokens": 300,
                   "output_tokens": 400, "reasoning_output_tokens": 50}}


def transcript(provider, text, usage):
    if provider == "claude":
        return json.dumps({"type": "result", "subtype": "success",
                           "is_error": False, "result": text, "usage": usage})
    return "\n".join([
        json.dumps({"type": "thread.started", "thread_id": "scenario"}),
        json.dumps({"type": "item.completed",
                    "item": {"type": "agent_message", "text": text}}),
        json.dumps({"type": "turn.completed", "usage": usage}),
    ])


def main(argv):
    provider = os.path.basename(sys.argv[0])
    prompt = sys.stdin.read()
    role = role_of(provider, argv)
    profiles = json.loads(os.environ.get("SCENARIO_AGENTS") or "{}")
    profile = profiles.get(role, "cooperative")
    phase = phase_of(prompt)
    context = dict(told(prompt), prompt=prompt, model=model_of(argv), argv=argv)
    entry = {"tool": provider, "role": role, "phase": phase, "profile": profile,
             "argv": argv, "model": context["model"], "prompt": prompt,
             "story": context["story"], "head": context["head"],
             "round": context["round"]}
    rc = 0
    try:
        behaviour = PROFILES[profile][phase]
        text = behaviour(context)
        # A behaviour returns its words, or (words, usage) to report other counts.
        text, usage = text if isinstance(text, tuple) else (text, USAGE[provider])
        entry.update(text=text, usage=usage)
        print(transcript(provider, text, usage))
    except Exception as exc:                    # noqa: BLE001 - reported, not hidden
        entry["error"] = "%s: %s" % (type(exc).__name__, exc)
        sys.stderr.write("scripted agent failed: %s\n" % entry["error"])
        rc = 70
    entry["rc"] = rc
    with open(os.environ["SCENARIO_LOG"], "a") as fh:
        fh.write(json.dumps(entry) + "\n")
    return rc


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
