{
  "description": "One AFK Orphan Story goes from state:ready through implementation, an approving model review and completion to Passing.",
  "config": {
    "version": 1,
    "branching": {"base": "develop", "afk_merge": "squash"},
    "gating": [{"name": "test", "run": "true"}],
    "notify": {"github": "maintainer"},
    "models": {
      "profiles": [
        {"key": "impl", "provider": "claude", "model": "claude-scenario"},
        {"key": "rev", "provider": "codex", "model": "codex-scenario"}
      ],
      "defaults": {"implementation": "impl", "review": "rev"}
    },
    "review": {"wait_minutes": 0.1, "poll_seconds": 0.05}
  },
  "github": {
    "ci": [{"__typename": "CheckRun", "name": "test", "status": "COMPLETED", "conclusion": "SUCCESS"}],
    "issues": [
      {
        "number": 1,
        "title": "Add the greeting",
        "labels": ["type:afk", "prio:1", "state:ready"],
        "body": "## What to build\nA greeting.\n\n## Acceptance Criteria\n- [ ] the greeting exists\n\nParent: None\nDepends on: None\n"
      }
    ]
  },
  "agents": {"implementation": "cooperative", "review": "cooperative"},
  "ticks": 3,
  "expect": {"1": "passing"}
}
